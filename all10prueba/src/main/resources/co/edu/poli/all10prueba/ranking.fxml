<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="560.0" prefWidth="476.0" spacing="12.0"
      styleClass="root-container" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.all10.controller.RankingController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="titulo-principal" text="%ranking.titulo" />

      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <Tab text="%ranking.tab.global">
               <content>
                  <TableView fx:id="tblVelocidad">
                     <columns>
                        <TableColumn fx:id="colPos" maxWidth="50.0" text="%ranking.col.pos" />
                        <TableColumn fx:id="colJugador" text="%ranking.col.jugador" />
                        <TableColumn fx:id="colTiempo" maxWidth="80.0" text="%ranking.col.tiempo" />
                        <TableColumn fx:id="colFecha" minWidth="120.0" text="%ranking.col.fecha" />
                     </columns>
                  </TableView>
               </content>
            </Tab>
            <Tab text="%ranking.tab.mias">
               <content>
                  <TableView fx:id="tblMias">
                     <columns>
                        <TableColumn fx:id="colMiFecha" minWidth="120.0" text="%ranking.col.fecha" />
                        <TableColumn fx:id="colMiObjetivos" text="%ranking.col.objetivos" />
                        <TableColumn fx:id="colMiTiempo" text="%ranking.col.tiempo" />
                        <TableColumn fx:id="colMiPuntaje" text="%ranking.col.puntaje" />
                     </columns>
                  </TableView>
               </content>
            </Tab>
         </tabs>
      </TabPane>

      <Label fx:id="lblError" style="-fx-text-fill: #ef4444;" />
      <Button maxWidth="1.0E38" onAction="#cerrar" styleClass="btn-accion, btn-dificultad" text="%ranking.cerrar" />
   </children>
</VBox>
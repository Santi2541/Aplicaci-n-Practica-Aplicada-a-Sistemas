<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="620.0" prefWidth="476.0" spacing="15.0"
      styleClass="root-container" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.all10.controller.RegistroController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>

      <!-- SELECTOR DE IDIOMA -->
      <HBox alignment="CENTER_RIGHT">
         <children>
            <MenuButton fx:id="btnIdioma" styleClass="btn-idioma" text="&#127760;" />
         </children>
      </HBox>

      <!-- ENCABEZADO -->
      <VBox alignment="CENTER" spacing="2.0">
         <children>
            <Label styleClass="titulo-principal" text="AllTen" />
            <Label styleClass="subtexto-gris" text="%app.subtitulo" />
         </children>
      </VBox>

      <!-- TARJETA: LOGIN / REGISTRO / RECUPERAR -->
      <VBox spacing="8.0" styleClass="card-blanca">
         <children>
            <Label fx:id="lblTitulo" styleClass="titulo-seccion-morado" text="%login.titulo" textFill="#7c3aed" />
            <Label fx:id="lblAyuda" styleClass="microcopia" text="%login.ayuda" wrapText="true" />

            <Label styleClass="titulo-subseccion" text="%registro.usuario">
               <VBox.margin>
                  <Insets top="8.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="txtUsuario" promptText="%registro.usuario.prompt" />

            <Label fx:id="lblCodigo" managed="false" styleClass="titulo-subseccion" text="%recuperar.codigo" visible="false" />
            <TextField fx:id="txtCodigo" managed="false" promptText="%recuperar.codigo.prompt" visible="false" />

            <Label fx:id="lblClave" styleClass="titulo-subseccion" text="%registro.clave" />
            <PasswordField fx:id="txtClave" promptText="%registro.clave.prompt" />

            <Label fx:id="lblConfirmar" managed="false" styleClass="titulo-subseccion" text="%registro.confirmar" visible="false" />
            <PasswordField fx:id="txtConfirmacion" managed="false" promptText="%registro.confirmar.prompt" visible="false" />

            <Label fx:id="lblError" maxWidth="1.0E38" wrapText="true" />

            <Button fx:id="btnAccion" defaultButton="true" maxWidth="1.0E38" onAction="#accionPrincipal"
                    styleClass="btn-accion, btn-verificar" text="%login.boton">
               <VBox.margin>
                  <Insets top="8.0" />
               </VBox.margin>
            </Button>

            <VBox alignment="CENTER" spacing="2.0">
               <children>
                  <Hyperlink fx:id="lnkOlvide" onAction="#irARecuperar" text="%login.olvide" />
                  <Hyperlink fx:id="lnkCrearCuenta" onAction="#irARegistro" text="%login.crearCuenta" />
                  <Hyperlink fx:id="lnkIniciarSesion" managed="false" onAction="#irALogin" text="%registro.yaTienesCuenta" visible="false" />
               </children>
            </VBox>
         </children>
      </VBox>

   </children>
</VBox>
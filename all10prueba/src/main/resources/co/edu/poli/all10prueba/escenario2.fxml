<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="591.0" prefWidth="476.0" spacing="10.0"
      styleClass="root-container" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.all10.controller.AvanzadoController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>

      <!-- ENCABEZADO: tiempo y pistas -->
      <HBox alignment="CENTER_LEFT">
         <children>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="titulo-seccion-morado" text="TIEMPO" />
                  <Label fx:id="lblTiempo" styleClass="texto-tiempo" text="🕒 00:00" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT" spacing="4.0">
               <children>
                  <Label styleClass="texto-pistas" text="💡 Pistas" />
                  <HBox alignment="CENTER_RIGHT" spacing="6.0">
                     <children>
                        <Region fx:id="pista1" styleClass="circulo-pista" />
                        <Region fx:id="pista2" styleClass="circulo-pista" />
                        <Region fx:id="pista3" styleClass="circulo-pista" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- OBJETIVOS -->
      <VBox spacing="8.0" styleClass="card-objetivos">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label styleClass="titulo-seccion-morado" text="OBJETIVOS" />
                  <Label styleClass="badge-dificultad" text="RAÍZ Y POTENCIA" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label styleClass="leyenda-item, leyenda-completado" text="✔ Completado" />
                  <Label styleClass="leyenda-item, leyenda-actual" text="◯ Actual" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="6.0">
               <children>
                  <Button fx:id="btnPaso1" styleClass="btn-paso, paso-actual" text="1" />
                  <Button fx:id="btnPaso2" styleClass="btn-paso, paso-actual" text="2" />
                  <Button fx:id="btnPaso3" styleClass="btn-paso, paso-actual" text="3" />
                  <Button fx:id="btnPaso4" styleClass="btn-paso, paso-actual" text="4" />
                  <Button fx:id="btnPaso5" styleClass="btn-paso, paso-actual" text="5" />
                  <Button fx:id="btnPaso6" styleClass="btn-paso, paso-actual" text="6" />
                  <Button fx:id="btnPaso7" styleClass="btn-paso, paso-actual" text="7" />
                  <Button fx:id="btnPaso8" styleClass="btn-paso, paso-actual" text="8" />
                  <Button fx:id="btnPaso9" styleClass="btn-paso, paso-actual" text="9" />
                  <Button fx:id="btnPaso10" styleClass="btn-paso, paso-actual" text="10" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- EXPRESIÓN Y RESPUESTA -->
      <HBox spacing="12.0">
         <children>
            <VBox alignment="CENTER" minHeight="80.0" styleClass="card-operacion" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblExpresion" styleClass="texto-expresion" />
               </children>
            </VBox>
            <VBox alignment="CENTER" minHeight="80.0" minWidth="120.0" spacing="4.0" styleClass="card-respuesta">
               <children>
                  <Label fx:id="lblIconoRespuesta" styleClass="icono-respuesta" text="?" />
                  <Label fx:id="lblRespuesta" styleClass="microcopia" text="Tu respuesta" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- NÚMEROS -->
      <VBox spacing="5.0">
         <children>
            <HBox alignment="CENTER" spacing="10.0">
			   <children>
			      <Button fx:id="btnNum1" maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-num, num-1" text="3" HBox.hgrow="ALWAYS" />
			      <Button fx:id="btnNum2" maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-num, num-2" text="6" HBox.hgrow="ALWAYS" />
			      <Button fx:id="btnNum3" maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-num, num-3" text="9" HBox.hgrow="ALWAYS" />
			      <Button fx:id="btnNum4" maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-num, num-4" text="2" HBox.hgrow="ALWAYS" />
			   </children>
			</HBox>
            <Label alignment="CENTER" maxWidth="1.0E38" styleClass="microcopia"
                   text="👆 Toca un número para agregarlo a la operación" />
         </children>
      </VBox>

      <!-- OPERADORES -->
      <VBox spacing="8.0">
		   <children>
		      <HBox alignment="CENTER" spacing="8.0">
		         <children>
		            <Button maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-operador" text="+" HBox.hgrow="ALWAYS" />
		            <Button maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-operador" text="-" HBox.hgrow="ALWAYS" />
		            <Button maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-operador" text="×" HBox.hgrow="ALWAYS" />
		            <Button maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-operador" text="÷" HBox.hgrow="ALWAYS" />
		         </children>
		      </HBox>
		      <HBox alignment="CENTER" spacing="8.0">
		         <children>
		            <Button maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-operador" text="√" HBox.hgrow="ALWAYS" />
		            <Button fx:id="btnPotencia" maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-operador" text="xʸ" HBox.hgrow="ALWAYS" />
		            <Button maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-operador" text="(" HBox.hgrow="ALWAYS" />
		            <Button maxWidth="1.0E38" onAction="#presionarBoton" styleClass="btn-operador" text=")" HBox.hgrow="ALWAYS" />
		         </children>
		      </HBox>
		   </children>
		</VBox>

      <!-- ACCIONES -->
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="btnBorrar" maxWidth="1.0E38" onAction="#borrarUltimo" styleClass="btn-accion, btn-limpiar" text="Borrar" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnPista" maxWidth="1.0E38" styleClass="btn-accion, btn-pista" text="💡 Pista" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnVerificar" maxWidth="1.0E38" onAction="#calcularResultado" styleClass="btn-accion, btn-verificar" text="Verificar ✓" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>

      <!-- LEYENDA -->
      <HBox alignment="CENTER" spacing="12.0" styleClass="footer-leyenda">
         <children>
            <VBox alignment="CENTER"><children><Label styleClass="lbl-bold" text="✔ Correcto" /><Label styleClass="subtexto-gris" text="Respuesta correcta" /></children></VBox>
            <Label text="|" />
            <VBox alignment="CENTER"><children><Label styleClass="lbl-bold" text="✖ Incorrecto" /><Label styleClass="subtexto-gris" text="Respuesta incorrecta" /></children></VBox>
            <Label text="|" />
            <VBox alignment="CENTER"><children><Label styleClass="lbl-bold" text="💡 Pista usada" /><Label styleClass="subtexto-gris" text="Usaste una pista" /></children></VBox>
            <Label text="|" />
            <VBox alignment="CENTER"><children><Label styleClass="lbl-bold" text="👆 Seleccionado" /><Label styleClass="subtexto-gris" text="Elemento en uso" /></children></VBox>
         </children>
      </HBox>

      <!-- VOLVER (no está en el diseño, pero lo necesitamos para navegar) -->
      <Button maxWidth="1.0E38" onAction="#volver" styleClass="btn-accion, btn-dificultad" text="← Volver al juego" />

   </children>
</VBox>